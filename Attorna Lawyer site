<!DOCTYPE html>
<html lang="en-US">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Attorna &#8211; Lawyer &amp; Attorney WordPress Theme</title>
<meta name="description" content="Attorna - a leading law firm in the financial & business industry with more than 20 years of experience.">

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@100;200;300;400;500;600;700;800;900&family=Montserrat:wght@300;400;500;600;700&family=Merriweather:wght@300;400;700;900&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>
/* ============================================================
   0. VARIABLES / RESET / BASE
   ============================================================ */
:root{
  --gold:#b1976b;
  --gold-2:#c9b28c;
  --gold-dark:#8f7750;
  --dark:#0a0a0a;
  --dark-2:#101010;
  --dark-3:#161616;
  --line:rgba(255,255,255,.10);
  --muted:#9a9a9a;
  --cont:1280px;
  --head:'Poppins',sans-serif;
  --body:'Montserrat',sans-serif;
  --serif:'Merriweather',serif;
}
*,*::before,*::after{box-sizing:border-box;}
html{scroll-behavior:smooth;}
body{
  margin:0;
  font-family:var(--body);
  font-size:15px;
  line-height:1.85;
  color:#8b8b8b;
  background:#fff;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}
img{max-width:100%;height:auto;display:block;border:0;}
a{text-decoration:none;color:inherit;transition:color .25s ease, background-color .25s ease, border-color .25s ease;}
ul{margin:0;padding:0;list-style:none;}
p{margin:0 0 18px;}
p:last-child{margin-bottom:0;}
h1,h2,h3,h4,h5,h6{font-family:var(--head);margin:0;font-weight:700;line-height:1.28;color:#161616;}
::selection{background:var(--gold);color:#fff;}

.container{width:100%;max-width:var(--cont);margin:0 auto;padding:0 30px;}
.sec{position:relative;padding:110px 0;}
.sec-sm{padding:80px 0;}
.sec-dark{background:#0a0a0a;color:#9a9a9a;}
.sec-dark h1,.sec-dark h2,.sec-dark h3,.sec-dark h4,.sec-dark h5,.sec-dark h6{color:#fff;}
.sec-light{background:#f7f7f7;}
.text-center{text-align:center;}

/* Section heading */
.sec-head{max-width:760px;margin:0 auto 60px;text-align:center;}
.sec-head .kicker{
  display:inline-block;font-family:var(--head);font-size:12px;font-weight:600;
  letter-spacing:3px;text-transform:uppercase;color:var(--gold);margin-bottom:14px;
}
.sec-head h2{font-size:34px;letter-spacing:0;line-height:1.25;}
.sec-head .divider{
  width:48px;height:2px;background:var(--gold);margin:22px auto 24px;position:relative;
}
.sec-head .divider::before{
  content:'';position:absolute;left:50%;top:50%;width:7px;height:7px;background:var(--gold);
  transform:translate(-50%,-50%) rotate(45deg);
}
.sec-head p{color:#9a9a9a;font-size:14.5px;line-height:1.9;margin:0;}
.sec-light .sec-head p{color:#7c7c7c;}

/* Buttons */
.btn{
  display:inline-flex;align-items:center;gap:12px;
  font-family:var(--head);font-size:12px;font-weight:600;letter-spacing:2px;text-transform:uppercase;
  padding:16px 34px;border:1px solid var(--gold);color:var(--gold);background:transparent;
  cursor:pointer;transition:all .3s ease;line-height:1;
}
.btn:hover{background:var(--gold);color:#fff;}
.btn-solid{background:var(--gold);color:#fff;}
.btn-solid:hover{background:transparent;color:var(--gold);}
.btn-white{border-color:#fff;color:#fff;}
.btn-white:hover{background:#fff;color:#111;}
.btn i{font-size:12px;transition:transform .3s ease;}
.btn:hover i{transform:translateX(5px);}

/* ============================================================
   1. HEADER  (top bar + navigation)
   ============================================================ */
.site-header-wrap{
  position:fixed;top:0;left:0;width:100%;z-index:900;
  transition:background-color .35s ease, box-shadow .35s ease;
}
.site-header-wrap.is-stuck{
  background:rgba(10,10,10,.97);
  box-shadow:0 10px 30px rgba(0,0,0,.45);
  backdrop-filter:blur(6px);
}

/* --- Top bar --- */
.top-bar{
  background:rgba(8,8,8,.55);
  border-bottom:1px solid rgba(255,255,255,.07);
  font-family:var(--head);
  font-size:12.5px;
  color:#d5d5d5;
  max-height:60px;
  overflow:hidden;
  transition:max-height .4s ease, opacity .3s ease, padding .4s ease;
}
.site-header-wrap.is-stuck .top-bar{max-height:0;opacity:0;border-bottom-color:transparent;}
.top-bar-inner{display:flex;align-items:center;justify-content:space-between;min-height:52px;gap:20px;}
.top-bar-left{display:flex;align-items:center;flex-wrap:wrap;gap:8px;font-size:12.5px;}
.top-bar-left i{color:var(--gold);font-size:13px;margin-right:8px;}
.top-bar-left .sep{color:#4a4a4a;margin:0 6px;}
.top-bar-left a:hover{color:var(--gold);}
.top-bar-right{display:flex;align-items:center;gap:26px;}
.top-bar-social{display:flex;align-items:center;gap:4px;}
.top-bar-social a{
  width:30px;height:30px;display:flex;align-items:center;justify-content:center;
  color:#cfcfcf;font-size:12.5px;border-radius:50%;
}
.top-bar-social a:hover{color:var(--gold);}
.top-bar-btn{
  display:inline-flex;align-items:center;gap:9px;
  background:var(--gold);color:#fff;font-family:var(--head);font-size:11.5px;font-weight:600;
  letter-spacing:1.6px;text-transform:uppercase;padding:10px 20px;line-height:1;
  transition:background-color .3s ease;
}
.top-bar-btn:hover{background:#fff;color:#111;}

/* --- Main header --- */
.main-header{
  border-bottom:1px solid rgba(255,255,255,.08);
  transition:border-color .3s ease;
}
.site-header-wrap.is-stuck .main-header{border-bottom-color:transparent;}
.main-header-inner{display:flex;align-items:center;justify-content:space-between;min-height:88px;gap:30px;}

/* Logo */
.logo{display:flex;align-items:center;gap:13px;}
.logo-mark{
  width:44px;height:44px;display:flex;align-items:center;justify-content:center;
  border:1px solid rgba(177,151,107,.55);color:var(--gold);font-size:17px;
  transition:all .3s ease;
}
.logo:hover .logo-mark{background:var(--gold);color:#fff;border-color:var(--gold);}
.logo-text{
  font-family:var(--head);font-size:26px;font-weight:700;letter-spacing:2px;
  color:#fff;line-height:1;text-transform:uppercase;
}
.logo-text span{
  display:block;font-size:9px;font-weight:500;letter-spacing:4.5px;
  color:var(--gold);margin-top:6px;
}

/* Navigation */
.main-nav{display:flex;align-items:center;}
.main-nav > ul{display:flex;align-items:center;}
.main-nav > ul > li{position:relative;}
.main-nav > ul > li > a{
  display:block;padding:0 17px;line-height:88px;
  font-family:var(--head);font-size:12.5px;font-weight:500;letter-spacing:1.3px;
  text-transform:uppercase;color:#ffffff;
}
.main-nav > ul > li > a:hover,
.main-nav > ul > li.current > a{color:var(--gold);}
.main-nav > ul > li > a .caret{font-size:8px;margin-left:6px;opacity:.7;}

.dropdown{
  position:absolute;top:100%;left:0;min-width:235px;
  background:#0d0d0d;border-top:2px solid var(--gold);
  padding:12px 0;box-shadow:0 22px 45px rgba(0,0,0,.55);
  opacity:0;visibility:hidden;transform:translateY(14px);
  transition:opacity .3s ease, transform .3s ease, visibility .3s ease;
  z-index:50;
}
.main-nav li:hover > .dropdown{opacity:1;visibility:visible;transform:translateY(0);}
.dropdown a{
  display:block;padding:9px 24px;font-family:var(--head);
  font-size:12px;letter-spacing:.7px;color:#bdbdbd;
}
.dropdown a:hover{color:var(--gold);background:rgba(255,255,255,.045);padding-left:29px;}

.header-tools{display:flex;align-items:center;gap:6px;margin-left:14px;}
.header-tools .tool{
  width:40px;height:40px;display:flex;align-items:center;justify-content:center;
  color:#fff;font-size:14px;cursor:pointer;transition:color .3s ease;
}
.header-tools .tool:hover{color:var(--gold);}

/* Hamburger */
.nav-toggle{
  display:none;width:44px;height:44px;border:1px solid rgba(255,255,255,.2);
  background:transparent;cursor:pointer;padding:0;position:relative;
}
.nav-toggle span{
  position:absolute;left:50%;width:20px;height:2px;background:#fff;
  transform:translateX(-50%);transition:all .3s ease;
}
.nav-toggle span:nth-child(1){top:15px;}
.nav-toggle span:nth-child(2){top:21px;}
.nav-toggle span:nth-child(3){top:27px;}
body.nav-open .nav-toggle span:nth-child(1){top:21px;transform:translateX(-50%) rotate(45deg);}
body.nav-open .nav-toggle span:nth-child(2){opacity:0;}
body.nav-open .nav-toggle span:nth-child(3){top:21px;transform:translateX(-50%) rotate(-45deg);}

/* Mobile panel */
.mobile-panel{
  position:fixed;top:0;right:0;width:320px;max-width:88vw;height:100%;
  background:#0b0b0b;z-index:1000;padding:90px 30px 40px;
  overflow-y:auto;transform:translateX(105%);transition:transform .4s cubic-bezier(.7,0,.3,1);
  border-left:1px solid rgba(255,255,255,.08);
}
body.nav-open .mobile-panel{transform:translateX(0);}
.mobile-panel ul li a{
  display:block;padding:13px 0;font-family:var(--head);font-size:13px;letter-spacing:1.4px;
  text-transform:uppercase;color:#d8d8d8;border-bottom:1px solid rgba(255,255,255,.07);
}
.mobile-panel ul li a:hover{color:var(--gold);}
.mobile-panel .sub a{padding-left:18px;font-size:12px;color:#9c9c9c;letter-spacing:1px;text-transform:none;}
.mobile-close{
  position:absolute;top:24px;right:24px;width:42px;height:42px;border:1px solid rgba(255,255,255,.18);
  background:transparent;color:#fff;font-size:16px;cursor:pointer;
}
.nav-overlay{
  position:fixed;inset:0;background:rgba(0,0,0,.65);z-index:999;
  opacity:0;visibility:hidden;transition:all .35s ease;backdrop-filter:blur(2px);
}
body.nav-open .nav-overlay{opacity:1;visibility:visible;}

/* ============================================================
   2. HERO SLIDER
   ============================================================ */
.hero{
  position:relative;height:880px;min-height:600px;overflow:hidden;background:#0f0f0f;
}
.hero-slide{
  position:absolute;inset:0;
  background-size:cover;background-position:center center;background-color:#141414;
  opacity:0;transition:opacity 1.1s ease;
  display:flex;align-items:center;
}
.hero-slide.active{opacity:1;}
.hero-slide::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(90deg, rgba(5,5,5,.90) 0%, rgba(5,5,5,.72) 45%, rgba(5,5,5,.35) 100%);
}
.hero-inner{
  position:relative;z-index:2;width:100%;max-width:var(--cont);margin:0 auto;
  padding:170px 30px 130px;
}
.hero-content{max-width:660px;}
.hero-kicker{
  display:inline-block;font-family:var(--head);font-size:13px;font-weight:500;
  letter-spacing:6px;text-transform:uppercase;color:var(--gold);
  margin-bottom:16px;opacity:0;transform:translateY(26px);
}
.hero-title{
  font-family:var(--head);font-size:82px;font-weight:700;line-height:1.02;
  color:#fff;letter-spacing:-1px;margin:0 0 26px;
  opacity:0;transform:translateY(26px);
}
.hero-text{
  font-family:var(--body);font-size:16px;line-height:1.95;color:#cfcfcf;
  max-width:520px;margin:0 0 38px;font-weight:300;
  opacity:0;transform:translateY(26px);
}
.hero-actions{opacity:0;transform:translateY(26px);}

.hero-slide.active .hero-kicker{animation:heroUp .9s .25s forwards;}
.hero-slide.active .hero-title{animation:heroUp .9s .42s forwards;}
.hero-slide.active .hero-text{animation:heroUp .9s .60s forwards;}
.hero-slide.active .hero-actions{animation:heroUp .9s .78s forwards;}
@keyframes heroUp{to{opacity:1;transform:translateY(0);}}

/* Slider dots */
.hero-dots{
  position:absolute;left:50%;bottom:150px;transform:translateX(-50%);
  display:flex;gap:12px;z-index:5;
}
.hero-dots button{
  width:34px;height:3px;border:0;background:rgba(255,255,255,.30);
  cursor:pointer;padding:0;transition:background-color .3s ease, width .3s ease;
}
.hero-dots button.active{background:var(--gold);width:52px;}

/* ============================================================
   3. AWARDS + ABOUT
   ============================================================ */
.about-sec{
  position:relative;
  padding:0 0 110px;
  background:#0c0c0c;
  color:#a3a3a3;
}
.about-sec::before{
  content:'';position:absolute;inset:0;
  background-image:url('https://demo.goodlayers.com/attorna/demo2/wp-content/uploads/2019/02/GFED.jpg');
  background-size:cover;background-position:center;background-repeat:no-repeat;
  background-attachment:fixed;
  opacity:.16;
}
.about-sec::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(10,10,10,.92) 0%, rgba(10,10,10,.86) 40%, #0a0a0a 100%);
}
.about-sec .container{position:relative;z-index:3;}

/* Award cards row */
.awards-row{
  display:grid;grid-template-columns:repeat(3,1fr);gap:0;
  margin-top:-100px;
}
.award-card{
  position:relative;padding:72px 35px 46px;text-align:center;
  background-color:#0a0a0a;
  background-size:cover;background-position:center;background-repeat:no-repeat;
  border-radius:3px;
  transition:transform .4s ease, box-shadow .4s ease;
  overflow:hidden;
}
.award-card::before{
  content:'';position:absolute;inset:0;background:rgba(6,6,6,.80);
  transition:background-color .4s ease;
}
.award-card:hover::before{background:rgba(6,6,6,.68);}
.award-card:hover{transform:translateY(-8px);box-shadow:0 25px 50px rgba(0,0,0,.55);}
.award-card > *{position:relative;z-index:2;}
.award-icon{
  width:70px;height:70px;margin:0 auto 26px;display:flex;align-items:center;justify-content:center;
  border:1px solid rgba(177,151,107,.45);border-radius:50%;color:var(--gold);
  font-size:24px;transition:all .4s ease;
}
.award-card:hover .award-icon{background:var(--gold);color:#111;border-color:var(--gold);}
.award-card h3{
  font-family:var(--head);font-size:14px;font-weight:700;letter-spacing:2.4px;
  text-transform:uppercase;color:#fff;margin:0 0 16px;
}
.award-card p{font-size:13.5px;line-height:1.85;color:#a0a0a0;margin:0;}

/* About block */
.about-block{
  display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;
  margin-top:100px;
}
.about-text .kicker{
  display:inline-block;font-family:var(--head);font-size:11.5px;font-weight:600;
  letter-spacing:3.4px;text-transform:uppercase;color:var(--gold);margin-bottom:16px;
}
.about-text h2{
  font-family:var(--head);font-size:36px;font-weight:700;color:#fff;
  line-height:1.28;margin:0 0 26px;
}
.about-text p{color:#a2a2a2;font-size:14.5px;line-height:1.95;margin-bottom:20px;}
.about-sign{margin-top:34px;display:flex;align-items:center;gap:22px;}
.about-sign img{width:190px;height:auto;opacity:.92;}
.about-sign .sign-name{
  font-family:var(--head);font-size:11px;font-weight:400;letter-spacing:3px;
  text-transform:uppercase;color:#fff;line-height:1.9;border-left:1px solid rgba(255,255,255,.16);
  padding-left:22px;
}
.about-sign .sign-name em{display:block;font-style:normal;color:var(--gold);font-size:10px;letter-spacing:2.6px;margin-top:4px;}

.about-media{position:relative;}
.about-media .frame{
  position:relative;overflow:hidden;border:1px solid rgba(177,151,107,.30);
  border-radius:3px;
}
.about-media img{width:100%;height:520px;object-fit:cover;transition:transform .8s ease;}
.about-media:hover img{transform:scale(1.05);}
.about-media .badge{
  position:absolute;left:-30px;bottom:40px;background:var(--gold);color:#141414;
  padding:22px 30px;border-radius:3px;text-align:center;box-shadow:0 18px 38px rgba(0,0,0,.45);
}
.about-media .badge strong{
  display:block;font-family:var(--head);font-size:36px;font-weight:700;line-height:1;color:#111;
}
.about-media .badge span{
  display:block;font-family:var(--head);font-size:10px;font-weight:600;letter-spacing:2.4px;
  text-transform:uppercase;color:#2c2418;margin-top:8px;
}

/* ============================================================
   4. PRACTICE AREAS
   ============================================================ */
.practice-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:30px;}
.practice-card{
  background:#fff;border:1px solid #ececec;padding:46px 38px 42px;
  position:relative;overflow:hidden;transition:all .4s ease;
}
.practice-card::after{
  content:'';position:absolute;left:0;bottom:0;width:100%;height:3px;
  background:var(--gold);transform:scaleX(0);transform-origin:left;transition:transform .45s ease;
}
.practice-card:hover{box-shadow:0 30px 60px rgba(0,0,0,.10);transform:translateY(-6px);}
.practice-card:hover::after{transform:scaleX(1);}
.practice-num{
  position:absolute;top:16px;right:24px;font-family:var(--head);font-size:54px;
  font-weight:800;color:#f4f4f4;line-height:1;user-select:none;
}
.practice-icon{
  width:64px;height:64px;display:flex;align-items:center;justify-content:center;
  background:#f6f3ee;color:var(--gold);font-size:24px;margin-bottom:26px;
  transition:all .4s ease;border-radius:2px;
}
.practice-card:hover .practice-icon{background:var(--gold);color:#fff;}
.practice-card h3{font-size:19px;font-weight:600;color:#161616;margin:0 0 14px;}
.practice-card p{font-size:14px;line-height:1.9;color:#8b8b8b;margin:0 0 20px;}
.practice-link{
  font-family:var(--head);font-size:11px;font-weight:600;letter-spacing:2.2px;
  text-transform:uppercase;color:#161616;display:inline-flex;align-items:center;gap:10px;
}
.practice-link i{font-size:10px;color:var(--gold);transition:transform .3s ease;}
.practice-card:hover .practice-link{color:var(--gold);}
.practice-card:hover .practice-link i{transform:translateX(5px);}

/* ============================================================
   5. COUNTERS
   ============================================================ */
.counters-sec{
  position:relative;
  padding:100px 0;
  background:#0a0a0a;
  color:#fff;
  overflow:hidden;
}
.counters-sec::before{
  content:'';position:absolute;inset:0;
  background-image:url('https://images.unsplash.com/photo-1589829545856-d10d557cf95f?auto=format&fit=crop&w=1800&q=80');
  background-size:cover;background-position:center;background-attachment:fixed;
  opacity:.22;
}
.counters-sec::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(10,10,10,.92), rgba(10,10,10,.88));
}
.counters-sec .container{position:relative;z-index:2;}
.counters-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;text-align:center;}
.counter-item{padding:20px 10px;position:relative;}
.counter-item:not(:last-child)::after{
  content:'';position:absolute;right:-15px;top:50%;transform:translateY(-50%);
  width:1px;height:70px;background:rgba(255,255,255,.12);
}
.counter-num{
  font-family:var(--head);font-size:52px;font-weight:700;color:#fff;line-height:1;
  display:flex;align-items:baseline;justify-content:center;gap:2px;
}
.counter-num .suffix{color:var(--gold);font-size:38px;}
.counter-label{
  font-family:var(--head);font-size:11.5px;font-weight:500;letter-spacing:2.6px;
  text-transform:uppercase;color:#b3b3b3;margin-top:16px;
}

/* ============================================================
   6. ATTORNEYS
   ============================================================ */
.team-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:30px;}
.team-card{background:#fff;overflow:hidden;transition:transform .4s ease;}
.team-card:hover{transform:translateY(-8px);}
.team-media{position:relative;overflow:hidden;background:#eee;}
.team-media img{width:100%;height:340px;object-fit:cover;transition:transform .8s ease, filter .5s ease;}
.team-card:hover .team-media img{transform:scale(1.07);}
.team-media::after{
  content:'';position:absolute;inset:0;
  background:linear-gradient(180deg, rgba(0,0,0,0) 40%, rgba(0,0,0,.72) 100%);
  opacity:0;transition:opacity .4s ease;
}
.team-card:hover .team-media::after{opacity:1;}
.team-social{
  position:absolute;left:0;bottom:22px;width:100%;display:flex;justify-content:center;gap:8px;
  z-index:3;opacity:0;transform:translateY(16px);transition:all .4s ease;
}
.team-card:hover .team-social{opacity:1;transform:translateY(0);}
.team-social a{
  width:38px;height:38px;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.12);color:#fff;font-size:13px;border-radius:50%;
  backdrop-filter:blur(3px);
}
.team-social a:hover{background:var(--gold);color:#fff;}
.team-body{padding:26px 22px 30px;text-align:center;border:1px solid #f0f0f0;border-top:0;}
.team-body h3{font-size:17px;font-weight:600;color:#161616;margin:0 0 8px;}
.team-body span{
  font-family:var(--head);font-size:10.5px;font-weight:500;letter-spacing:2.4px;
  text-transform:uppercase;color:var(--gold);
}

/* ============================================================
   7. TESTIMONIALS
   ============================================================ */
.testi-sec{
